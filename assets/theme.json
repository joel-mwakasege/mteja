{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "parchment",
          "color": "#f7f7f4",
          "name": "Parchment (Canvas)"
        },
        {
          "slug": "bone",
          "color": "#f2f1ed",
          "name": "Bone (Card/Surface)"
        },
        {
          "slug": "linen",
          "color": "#e6e5e0",
          "name": "Linen (Secondary Fill)"
        },
        {
          "slug": "stone",
          "color": "#cdcdc9",
          "name": "Stone (Border Hairline)"
        },
        {
          "slug": "ink",
          "color": "#26251e",
          "name": "Ink (Primary Text & CTAs)"
        },
        {
          "slug": "ember",
          "color": "#f54e00",
          "name": "Ember (Inline Accent)"
        },
        {
          "slug": "amber",
          "color": "#c08532",
          "name": "Amber (Action/Diagnostics)"
        },
        {
          "slug": "forest",
          "color": "#34785c",
          "name": "Forest (Resolution/Success)"
        },
        {
          "slug": "ash",
          "color": "#7a7974",
          "name": "Ash (Muted Foreground)"
        },
        {
          "slug": "driftwood",
          "color": "#84847e",
          "name": "Driftwood (Secondary Body)"
        },
        {
          "slug": "mist",
          "color": "#a1a19f",
          "name": "Mist (Helper Text)"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "slug": "primary",
          "name": "Cursor Primary"
        },
        {
          "fontFamily": "'JetBrains Mono', monospace",
          "slug": "mono",
          "name": "Cursor Mono"
        },
        {
          "fontFamily": "'EB Garamond', Georgia, serif",
          "slug": "serif",
          "name": "Cursor Serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "tag",
          "size": "12px",
          "name": "Eyebrow / Tag"
        },
        {
          "slug": "small",
          "size": "14px",
          "name": "Body Small"
        },
        {
          "slug": "medium",
          "size": "16px",
          "name": "Body Regular"
        },
        {
          "slug": "heading-sm",
          "size": "22px",
          "name": "Heading SM"
        },
        {
          "slug": "heading-md",
          "size": "26px",
          "name": "Heading MD"
        },
        {
          "slug": "heading-lg",
          "size": "36px",
          "name": "Heading LG"
        },
        {
          "slug": "display-hero",
          "size": "clamp(38px, 6vw, 72px)",
          "name": "Display Hero"
        }
      ]
    },
    "layout": {
      "contentSize": "860px",
      "wideSize": "1240px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--parchment)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--primary)",
      "lineHeight": "1.5"
    },
    "elements": {
      "button": {
        "color": {
          "background": "var(--wp--preset--color--ink)",
          "text": "var(--wp--preset--color--parchment)"
        },
        "border": {
          "radius": "4px"
        }
      }
    }
  }
}
