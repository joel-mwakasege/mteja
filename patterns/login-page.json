  "description": "Minimalist Warm Parchment Atelier sign-in card matching Cursor design tokens and Emil Kowalski motion engineering, featuring async REST verification with native fallback.",
  "content": "<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"60px\",\"bottom\":\"60px\",\"left\":\"20px\",\"right\":\"20px\"},\"margin\":{\"top\":\"0px\",\"bottom\":\"0px\"}},\"color\":{\"background\":\"#f7f7f4\",\"text\":\"#26251e\"}},\"backgroundColor\":\"#f7f7f4\",\"textColor\":\"#26251e\",\"className\":\"mteja-login-canvas\",\"layout\":{\"type\":\"constrained\",\"contentSize\":\"440px\"}} -->\n<div class=\"wp-block-group alignfull mteja-login-canvas has-text-color has-background\" style=\"color:#26251e;background-color:#f7f7f4;min-height:100svh;display:flex;flex-direction:column;justify-content:center;align-items:center;margin-top:0px;margin-bottom:0px;padding-top:60px;padding-right:20px;padding-bottom:60px;padding-left:20px;font-family:'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;-webkit-font-smoothing:antialiased\">\n\n<!-- Center Login Card (8px radius, bone surface, hairline stone border) -->\n<!-- wp:group {\"style\":{\"color\":{\"background\":\"#f2f1ed\"},\"border\":{\"radius\":\"8px\",\"color\":\"#cdcdc9\",\"width\":\"1px\"},\"spacing\":{\"padding\":{\"top\":\"36px\",\"bottom\":\"36px\",\"left\":\"32px\",\"right\":\"32px\"}}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"100%\"}} -->\n<div class=\"wp-block-group has-background\" style=\"background-color:#f2f1ed;border-color:#cdcdc9;border-width:1px;border-radius:8px;border-style:solid;padding-top:36px;padding-right:32px;padding-bottom:32px;padding-left:32px;box-shadow:rgba(0, 0, 0, 0.14) 0px 14px 32px 0px;width:100%;max-width:440px\">\n\n<!-- Brand Icon & Wordmark Header -->\n<div style=\"text-align:center;margin-bottom:28px\">\n  <!-- Brand Logo Icon Container -->\n  <div class=\"mteja-logo-slot\" style=\"margin:0 auto 14px auto;width:44px;height:44px;border-radius:4px;background:#26251e;color:#f7f7f4;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 6px rgba(38,37,30,0.12)\" title=\"Mteja Support Operations\">\n    <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"></path>\n      <path d=\"M8 10h.01M12 10h.01M16 10h.01\" stroke-width=\"2.8\"></path>\n    </svg>\n  </div>\n\n  <h1 style=\"font-size:24px;font-weight:400;letter-spacing:-0.012em;color:#26251e;margin:0 0 6px 0\">\n    Sign in to Operations Desk\n  </h1>\n  <p style=\"font-size:13.5px;color:#7a7974;margin:0\">\n    Autonomous AI Support &bull; Supabase pgvector\n  </p>\n</div>\n\n<!-- wp:html -->\n<form id=\"mteja-login-form\" method=\"post\" action=\"/wp-login.php\" style=\"display:flex;flex-direction:column;gap:18px;\">\n  <!-- Dynamic Error Alert Box -->\n  <div id=\"mteja-login-error\" style=\"display:none;background:#fef2f2;border:1px solid #fca5a5;color:#991b1b;padding:10px 14px;border-radius:4px;font-size:13px;line-height:1.4;\"></div>\n\n  <!-- Username or Email Field -->\n  <div style=\"display:flex;flex-direction:column;gap:6px;\">\n    <label for=\"mteja_user_login\" style=\"font-size:13px;font-weight:500;color:#26251e;\">Username or Email</label>\n    <input type=\"text\" name=\"log\" id=\"mteja_user_login\" required autocomplete=\"username\" placeholder=\"name@company.com\" style=\"background:#f7f7f4;border:1px solid #cdcdc9;border-radius:4px;padding:11px 14px;font-size:16px;color:#26251e;outline:none;transition:border-color 150ms ease;\" onfocus=\"this.style.borderColor='#26251e';\" onblur=\"this.style.borderColor='#cdcdc9';\" />\n  </div>\n\n  <!-- Password Field -->\n  <div style=\"display:flex;flex-direction:column;gap:6px;\">\n    <div style=\"display:flex;justify-content:space-between;align-items:center;\">\n      <label for=\"mteja_user_pass\" style=\"font-size:13px;font-weight:500;color:#26251e;\">Password</label>\n      <a href=\"/wp-login.php?action=lostpassword\" style=\"font-size:12px;color:#7a7974;text-decoration:none;transition:color 150ms ease;\" onmouseover=\"this.style.color='#26251e';\" onmouseout=\"this.style.color='#7a7974';\">Forgot password?</a>\n    </div>\n    <input type=\"password\" name=\"pwd\" id=\"mteja_user_pass\" required autocomplete=\"current-password\" placeholder=\"••••••••••••\" style=\"background:#f7f7f4;border:1px solid #cdcdc9;border-radius:4px;padding:11px 14px;font-size:16px;color:#26251e;outline:none;transition:border-color 150ms ease;\" onfocus=\"this.style.borderColor='#26251e';\" onblur=\"this.style.borderColor='#cdcdc9';\" />\n  </div>\n\n  <!-- Remember Me Checkbox -->\n  <div style=\"display:flex;align-items:center;gap:8px;margin-top:2px;\">\n    <input type=\"checkbox\" name=\"rememberme\" id=\"mteja_rememberme\" value=\"forever\" style=\"width:16px;height:16px;border-radius:3px;border:1px solid #cdcdc9;accent-color:#26251e;cursor:pointer;\" />\n    <label for=\"mteja_rememberme\" style=\"font-size:13px;color:#7a7974;cursor:pointer;user-select:none;\">Stay signed in for 14 days</label>\n  </div>\n\n  <!-- Sign In Button (Workhorse 4px border radius, Emil Kowalski scale(0.97) feedback) -->\n  <button type=\"submit\" id=\"mteja-submit-btn\" style=\"background-color:#26251e;color:#f7f7f4;border:none;border-radius:4px;padding:12px 20px;font-size:14px;font-weight:500;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:transform 160ms cubic-bezier(0.23, 1, 0.32, 1), background-color 150ms ease;touch-action:manipulation;margin-top:6px;box-shadow:0 1px 3px rgba(38,37,30,0.1);\" onmousedown=\"this.style.transform='scale(0.97)';\" onmouseup=\"this.style.transform='scale(1)';\" onmouseleave=\"this.style.transform='scale(1)';\">\n    <span>Sign In to Desk</span>\n    <span aria-hidden=\"true\" style=\"opacity:0.8\">→</span>\n  </button>\n</form>\n\n<script>\n(function() {\n  const form = document.getElementById('mteja-login-form');\n  const errorBox = document.getElementById('mteja-login-error');\n  const submitBtn = document.getElementById('mteja-submit-btn');\n\n  if (!form) return;\n\n  form.addEventListener('submit', async function(e) {\n    e.preventDefault();\n    errorBox.style.display = 'none';\n    submitBtn.disabled = true;\n    submitBtn.innerHTML = '<span>Verifying credentials...</span>';\n\n    const username = document.getElementById('mteja_user_login').value;\n    const password = document.getElementById('mteja_user_pass').value;\n    const remember = document.getElementById('mteja_rememberme').checked;\n\n    try {\n      const response = await fetch('/wp-json/mteja/v1/auth/login', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({\n          username: username,\n          password: password,\n          remember: remember\n        })\n      });\n\n      if (response.ok) {\n        const data = await response.json();\n        submitBtn.innerHTML = '<span>Entering desk...</span>';\n        window.location.href = data.redirect_url || (window.location.origin + '/mteja');\n      } else {\n        if (response.status === 404) {\n          form.submit();\n          return;\n        }\n        const errorData = await response.json().catch(() => ({}));\n        errorBox.textContent = errorData.message || 'Invalid username or password. Please try again.';\n        errorBox.style.display = 'block';\n        submitBtn.disabled = false;\n        submitBtn.innerHTML = '<span>Sign In to Desk</span> <span aria-hidden=\"true\" style=\"opacity:0.8\">→</span>';\n      }\n    } catch (err) {\n      form.submit();\n    }\n  });\n})();\n</script>\n<!-- /wp:html -->\n\n</div>\n<!-- /wp:group -->\n\n<!-- Footer Return Link -->\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"13px\"}},\"spacing\":{\"margin\":{\"top\":\"24px\"}}} -->\n<p class=\"has-text-align-center\" style=\"font-size:13px;margin-top:24px\">\n  <a href=\"/\" style=\"color:#7a7974;text-decoration:none;transition:color 150ms ease;\" onmouseover=\"this.style.color='#26251e';\" onmouseout=\"this.style.color='#7a7974';\">&larr; Return to Homepage</a>\n</p>\n<!-- /wp:paragraph -->\n\n</div>\n<!-- /wp:group -->\n"
}